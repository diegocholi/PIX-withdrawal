# ------------------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------------------

# Nome lógico da aplicação usado em configuração e identificação básica do runtime.
APP_NAME=pix-withdrawal

# Ambiente da aplicação.
# Valores suportados pelo módulo de providers: local, test e prod.
APP_ENV=local

# Liga ou desliga modo de debug do bootstrap.
# Valores aceitos pelo PHP: true/false, 1/0, on/off, yes/no.
APP_DEBUG=false

# Locale principal da aplicação para configuração global inicial.
APP_LOCALE=pt_BR

# Locale de fallback usado quando não houver locale principal aplicável.
APP_FALLBACK_LOCALE=en

# Charset padrão aplicado ao runtime PHP.
APP_CHARSET=UTF-8

# Timezone padrão aplicada no bootstrap antes da subida do container DI.
APP_TIMEZONE=UTC

# Timezone exportada para o sistema do container e ferramentas de linha de comando.
TZ=UTC

# ------------------------------------------------------------------------------
# Observabilidade inicial
# ------------------------------------------------------------------------------

# Nível mínimo de log do Monolog.
# Exemplos válidos: DEBUG, INFO, NOTICE, WARNING, ERROR, CRITICAL, ALERT, EMERGENCY.
APP_LOG_LEVEL=INFO

# Quantidade máxima de arquivos mantidos na rotação diária do log da aplicação.
APP_LOG_MAX_FILES=14

# ------------------------------------------------------------------------------
# Runtime HTTP
# ------------------------------------------------------------------------------

# Host de bind do servidor HTTP do Hyperf.
HTTP_HOST=0.0.0.0

# Porta de bind do servidor HTTP do Hyperf.
HTTP_PORT=9501

# Quantidade de workers do servidor HTTP.
HTTP_WORKER_NUM=4

# ------------------------------------------------------------------------------
# Plugins avancados
# ------------------------------------------------------------------------------

# Titulo exibido na especificacao OpenAPI e na Swagger UI.
ADVANCED_OPENAPI_TITLE="PIX Withdrawal API"

# Versao semantica publicada no contrato OpenAPI.
ADVANCED_OPENAPI_VERSION=1.0.0

# Caminho HTTP publicado para o JSON da especificacao OpenAPI.
ADVANCED_OPENAPI_SPEC_PATH=/openapi.json

# Caminho HTTP publicado para a Swagger UI.
ADVANCED_SWAGGER_UI_PATH=/docs

# Habilita a Swagger UI para desenvolvimento e homologacao.
ADVANCED_SWAGGER_UI_ENABLED=true

# ------------------------------------------------------------------------------
# Runtime de container e CLI
# ------------------------------------------------------------------------------

# Diretório base da aplicação dentro do container, usado pelos entrypoints para preparar runtime e storage.
APP_DIR=/opt/apps/pix-withdrawal

# UID do usuário que deve executar o processo da aplicação dentro do container.
# Usar o UID do host evita arquivos gerados com owner incompatível em bind mounts locais.
APP_RUNTIME_UID=1000

# GID do grupo que deve executar o processo da aplicação dentro do container.
# Usar o GID do host evita arquivos gerados com group incompatível em bind mounts locais.
APP_RUNTIME_GID=1000

# ------------------------------------------------------------------------------
# Banco de dados
# ------------------------------------------------------------------------------

# Host do MySQL usado pela aplicação.
DB_HOST=mysql

# Porta TCP do MySQL.
DB_PORT=3306

# Nome do banco de dados principal da aplicação.
DB_DATABASE=pix_withdrawal

# Usuário de acesso ao banco de dados.
DB_USERNAME=pix_withdrawal

# Senha do usuário de acesso ao banco de dados.
DB_PASSWORD=pix_withdrawal

# ------------------------------------------------------------------------------
# Mensageria
# ------------------------------------------------------------------------------

# Janela em segundos usada pelo backend para bloquear retries idênticos recentes de criação de saque.
WITHDRAW_DUPLICATE_GUARD_WINDOW_SECONDS=60

# Intervalo em segundos do loop local que promove saques agendados vencidos para a fila Kafka.
WITHDRAW_SCHEDULER_POLL_INTERVAL_SECONDS=1

# Tamanho do lote avaliado a cada ciclo do scheduler local automatico.
WITHDRAW_SCHEDULER_BATCH_SIZE=100

# Lista de brokers Kafka usada por producers e consumers.
KAFKA_BROKERS=kafka:19092

# ------------------------------------------------------------------------------
# Email local
# ------------------------------------------------------------------------------

# Host do servidor SMTP de desenvolvimento usado para inspeção de emails.
MAIL_HOST=mailhog

# Porta SMTP do servidor de email local.
MAIL_PORT=1025

# Usuario usado para autenticacao SMTP quando o servidor exigir credenciais.
MAIL_USERNAME=

# Senha usada para autenticacao SMTP quando o servidor exigir credenciais.
MAIL_PASSWORD=

# Mecanismo de criptografia SMTP opcional, como tls ou ssl.
MAIL_ENCRYPTION=

# Endereco de email padrao usado como remetente das notificacoes.
MAIL_FROM_ADDRESS=no-reply@pix-withdrawal.local

# Nome padrao exibido como remetente das notificacoes.
MAIL_FROM_NAME="PIX Withdrawal"

# Timeout de conexao SMTP em segundos.
MAIL_CONNECT_TIMEOUT_SECONDS=5

# Timeout de leitura SMTP em segundos.
MAIL_READ_TIMEOUT_SECONDS=5

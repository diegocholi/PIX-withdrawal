{
    "name": "tecnofit/pix-withdrawal",
    "description": "Plataforma de saque PIX com arquitetura modular em PHP e Hyperf.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-redis": "*",
        "ext-sockets": "*",
        "ext-swoole": "*",
        "hyperf/command": "~3.1.0",
        "hyperf/config": "~3.1.0",
        "hyperf/db-connection": "~3.1.0",
        "hyperf/framework": "~3.1.0",
        "hyperf/http-server": "~3.1.0",
        "hyperf/logger": "~3.1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.15",
        "hyperf/testing": "~3.1.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Tecnofit\\PixWithdrawal\\": "app/",
            "Tecnofit\\PixWithdrawal\\Core\\": "app/Core/",
            "Tecnofit\\PixWithdrawal\\Adapters\\": "app/Adapters/",
            "Tecnofit\\PixWithdrawal\\Providers\\": "app/Providers/",
            "Tecnofit\\PixWithdrawal\\Plugins\\": "app/Plugins/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tecnofit\\PixWithdrawal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "composer:validate": "@composer validate --strict",
        "autoload": "@composer dump-autoload -o",
        "test": "@php vendor/bin/phpunit",
        "analyse": "@php vendor/bin/phpstan analyse",
        "cs:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
